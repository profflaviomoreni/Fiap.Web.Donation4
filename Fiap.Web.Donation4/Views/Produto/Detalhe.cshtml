@model ProdutoModel

<h1>Produto - Detalhe</h1>

<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <div class="well">
                <div class="form-group">
                    <label>Nome:</label>
                    <label>@Model.Nome</label>
                </div>
                <div class="form-group">
                    <label>Descrição:</label>
                    <label>@Model.Descricao</label>
                </div>
                <div class="form-group">
                    <label>Categoria:</label>
                    <label>@Model.CategoriaId - @Model.Categoria.NomeCategoria</label>
                </div>
            </div>
        </div>
    </div>
</div>