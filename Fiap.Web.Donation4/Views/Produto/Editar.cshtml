@model ProdutoModel

<h1>Produto - Editar</h1>

<div class="container">
    <div class="row">
        <div class="col-lg-12">
            <div class="well">

                @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage)) {
                    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                }

                <form method="post" asp-controller="Produto" asp-action="Editar">
                    <input type="hidden" name="ProdutoId" value="@Model.ProdutoId" />

                    <div class="form-group">
                        <label>Nome:</label>
                        <input asp-for="Nome" class="form-control w-50" />
                    </div>
                    <div class="form-group">
                        <label>Descrição:</label>
                        <input asp-for="Descricao" class="form-control w-75" />
                    </div>

                    <hr class="hr" />
                    <input type="submit" value="Enviar" />
                </form>
            </div>
        </div>
    </div>
</div>